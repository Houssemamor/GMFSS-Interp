# Runtime artefacts. Everything here is either regenerated by setup.bat or
# downloaded on demand, so keeping it out of history keeps the repo small.
.venv/
cache/
models/
tools/

# Python bytecode written next to the sources and the vendored package.
__pycache__/
*.py[cod]

# Media: sources are user content and outputs are large and reproducible.
*.mkv
*.mp4
*.part.*

# Temporary files created by the IDE.
.idea/
.planning/